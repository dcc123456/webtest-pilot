{
  "name": "webtest-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-driven browser test automation Chrome extension: drive pages with any OpenAI-compatible model, persist passing runs as replayable scripts, trigger them from a local HTTP/WebSocket bridge or a timer, and report to Feishu.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "bridge": "tsx bridge/main.ts serve"
  },
  "bin": {
    "webtest-pilot": "bridge/main.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.312",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  }
}
